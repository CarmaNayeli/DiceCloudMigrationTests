# MongoDB Connection (Source Database)
MONGODB_URI=mongodb://username:password@host:port/dicecloud?authSource=admin

# Supabase Connection (Target Database)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# PostgreSQL Direct Connection (for bulk operations)
POSTGRES_HOST=db.yourproject.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password

# Migration Settings
BATCH_SIZE=1000
MAX_RETRIES=3
CHECKPOINT_INTERVAL=10000
PARALLEL_BATCHES=5

# Logging
LOG_LEVEL=info
LOG_FILE=migration.log
