{
  "public": {
    "environment": "development",
    "disablePatreon": true,
    "usePostgres": {
      "creatures": true,
      "creatureProperties": true,
      "creatureVariables": true,
      "creatureLogs": true,
      "experiences": true,
      "libraries": true,
      "libraryNodes": true,
      "users": true
    }
  },
  "postgres": {
    "host": "db.yourproject.supabase.co",
    "port": 5432,
    "database": "postgres",
    "user": "postgres",
    "password": "your_database_password",
    "poolSize": 20,
    "supabaseUrl": "https://yourproject.supabase.co",
    "supabaseKey": "your_supabase_service_role_key"
  },
  "comment": "Replace the postgres values above with your actual Supabase credentials. Set usePostgres flags to false to use MongoDB for specific collections."
}
